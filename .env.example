PORT=3000

# PARTICIPANT_TOKEN lo leen el servidor, para aceptar ese Bearer, y el laboratorio.
# ORIGINAL_BASE_URL solo la lee el laboratorio.

ORIGINAL_BASE_URL=https://caja-negra-production-c64f.up.railway.app
PARTICIPANT_TOKEN=

